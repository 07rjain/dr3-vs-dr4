# Free Ahrefs API v3 key.
# Create one in Ahrefs: Account settings → API keys.
# https://docs.ahrefs.com/en/api/reference/public/get-domain-rating-free
#
# The Domain Rating endpoint does not consume API units, but Ahrefs requires this key.
# Keep it on the server. Never prefix it with NEXT_PUBLIC_.
AHREFS_API_KEY=
